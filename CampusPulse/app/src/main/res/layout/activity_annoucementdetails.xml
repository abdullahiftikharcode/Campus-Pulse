<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".EventDetail">

    <ScrollView
        android:id="@+id/scrollView2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="50dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="?android:attr/selectableItemBackground"
            android:orientation="vertical"
            android:padding="10dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_border"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardPreventCornerOverlap="true"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">


                        <ImageView
                            android:id="@+id/imageView2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:srcCompat="@drawable/aklogo" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/membername"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingStart="60dp"
                                android:text="Name"
                                android:textColor="@android:color/black"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/memberusername"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingStart="60dp"
                                android:text="username"
                                android:textColor="@android:color/darker_gray" />

                            <com.google.android.material.divider.MaterialDivider
                                android:id="@+id/full_bleed_divider"
                                android:layout_width="392dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                app:dividerColor="@color/grey" />

                            <TextView
                                android:id="@+id/time"
                                android:layout_width="match_parent"
                                android:layout_height="34dp"
                                android:paddingStart="8dp"
                                android:text="Time Date"
                                android:textSize="20sp" />

                            <TextView
                                android:id="@+id/announcementText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/abyssinica_sil"
                                android:paddingStart="10dp"
                                android:paddingTop="5dp"
                                android:text="Announcement text goes here"
                                android:textColor="@android:color/black"
                                android:textSize="22sp" />
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/textView4"
        android:layout_width="416dp"
        android:layout_height="43dp"
        android:layout_marginBottom="7dp"
        android:background="@color/purple"
        android:paddingStart="80dp"
        android:paddingTop="5dp"
        android:text="Annoucement"
        android:textColor="@color/white"
        android:textSize="24sp"
        app:layout_constraintBottom_toTopOf="@+id/scrollView2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/button_back"
        android:layout_width="70dp"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        android:paddingBottom="10dp"
        app:icon="@android:drawable/ic_menu_close_clear_cancel"
        app:iconGravity="start|textStart"
        app:iconSize="45dp"
        app:iconTint="@color/black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>